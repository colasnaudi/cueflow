# PostgreSQL (docker/docker-compose.yml exposes 5433 to avoid clashing with a local Postgres)
DATABASE_URL=postgresql+psycopg://cueflow:cueflow@localhost:5433/cueflow

# Default folder scanned by the Library "Scan" button
MUSIC_ROOT=/Users/you/Music

# Ollama (used from MVP 0.3)
OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=gemma4:12b-it-qat
OLLAMA_EMBED_MODEL=embeddinggemma
EMBEDDING_DIM=768

# Web -> API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Parallel processes for library-wide audio analysis (each ~0.5 GB of RAM)
ANALYSIS_WORKERS=3

# Shift (ms) for MP3 cue positions in the Rekordbox export (decoder start offset, ~26 ms for some files)
REKORDBOX_MP3_OFFSET_MS=0

# Generated cue points are approved right away (edit them in Rekordbox). false = approve per track in Cueflow
AUTO_APPROVE_CUES=true
